# Copy to .env and adjust. All values are optional; defaults live in app/config.py.

# Providers are simulated while DEMO_MODE=true. Real OpenAI/Anthropic calls are attempted
# only when DEMO_MODE=false AND the matching key is set.
DEMO_MODE=true
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Use redis://localhost:6379/0 and localhost:29092 when running the app outside docker compose.
# If Redis/Kafka are unreachable the gateway falls back to in-memory stores and log output.
REDIS_URL=redis://redis:6379/0
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_AUDIT=llm-gateway-audit

RATE_LIMIT_ENABLED=true
RATE_LIMIT_TOKENS_PER_SECOND=100.0
RATE_LIMIT_BURST_CAPACITY=200.0

SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.88
SEMANTIC_CACHE_TTL_SECONDS=86400

CIRCUIT_BREAKER_FAILURE_THRESHOLD=4
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=15.0
EWMA_DECAY_ALPHA=0.25

# Flat per-1k-token rates used for the estimated cost metric (tokens are whitespace word counts).
COST_PER_1K_PROMPT_TOKENS=0.0015
COST_PER_1K_COMPLETION_TOKENS=0.0020
